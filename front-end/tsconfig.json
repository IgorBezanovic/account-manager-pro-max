{
  "compilerOptions": {
    "jsx": "react-jsx", // ✅ Required for React 17+ JSX transform
    "target": "ES2020", // ✅ Or higher
    "module": "ESNext",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}